{
  "name": "shahizwan-anis-wedding",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --mode groom",
    "dev:preview": "vite --host 127.0.0.1",
    "build": "npm run build:groom && npm run build:bride",
    "build:groom": "vite build --mode groom --outDir dist/groom",
    "build:bride": "vite build --mode bride --outDir dist/bride",
    "dev:groom": "vite --host 127.0.0.1 --mode groom",
    "dev:bride": "vite --host 127.0.0.1 --mode bride",
    "preview": "vite preview --host 127.0.0.1",
    "preview:groom": "vite preview --host 127.0.0.1 --outDir dist/groom",
    "preview:bride": "vite preview --host 127.0.0.1 --outDir dist/bride",
    "test": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "vite": "^8.3.1"
  },
  "dependencies": {
    "@fontsource/allura": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/great-vibes": "^5.3.0"
  }
}
